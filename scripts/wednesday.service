# Optional systemd *user* unit for the backend only (the avatar needs your graphical session,
# so start it from Hyprland: `exec-once = <repo>/wednesday start`).
#
# Install:   mkdir -p ~/.config/systemd/user && sed "s|@REPO@|$PWD|g" scripts/wednesday.service > ~/.config/systemd/user/wednesday.service
#            systemctl --user daemon-reload && systemctl --user enable --now wednesday.service
# Remove:    systemctl --user disable --now wednesday.service && rm ~/.config/systemd/user/wednesday.service
[Unit]
Description=Wednesday local AI assistant (backend)
After=pipewire.service

[Service]
Type=simple
Environment=PYTHONPATH=@REPO@/src
ExecStart=@REPO@/.venv/bin/python -m wednesday backend
Restart=on-failure
RestartSec=5
# Defence in depth: the backend never needs these.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
